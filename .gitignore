node_modules/
dist/

# Runtime artifacts
logs/
.prompt-*.txt
.system-prompt-*.txt

# Env files (this repo never holds .env — consumers own their own
# .env in the agents repo that uses this dispatcher)
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code per-session state
.claude/

# CodeGraph index — local code-intel cache for interactive sessions.
# Anchored, no trailing slash: matches both directories AND symlinks
# (the trailing-slash variant `.codegraph/` only matches directories,
# which let a dispatcher-worktree symlink slip past gitignore in
# pyrycode/pyrycode commit 30f3d53 before that gap was fixed). Same
# defensive shape applied here, even though this repo isn't an agent
# target (no auto-commit chain to bite it) — cheaper than the chance
# of a future scenario where it does.
/.codegraph

# Eval harness cache of raw GitHub responses (src/eval/) — rebuildable,
# potentially large, never source.
/.eval-cache/
