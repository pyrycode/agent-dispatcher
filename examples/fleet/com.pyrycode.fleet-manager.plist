<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.pyrycode.fleet-manager</string>
  <key>ProgramArguments</key><array><string>/absolute/path/to/start-fleet-manager</string></array>
  <key>WorkingDirectory</key><string>/absolute/path/to/agent-dispatcher</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/absolute/private/path/manager.log</string>
  <key>StandardErrorPath</key><string>/absolute/private/path/manager.error.log</string>
</dict></plist>
